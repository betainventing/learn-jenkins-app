pipeline {
    agent any
    
    stages {
        stage('BUILD') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    pwd
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la                       
                '''
            }
        }
        
        stage('TEST') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                   test -f build/index.html
                   echo $? 
                '''
            }
            
        }
    }
}